# Local defaults. Do not commit the real .env file.
MSME_SECRET=replace-with-64-random-hex-characters
MSME_ADMIN_PASSWORD=replace-with-a-strong-password

# Set to 1 when serving over HTTPS outside Vercel.
# MSME_HTTPS=1

# Local development uses SQLite at data/survey.db when this is unset.
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler.
# URL-encode special characters in the password (@ -> %40, # -> %23, etc.).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
